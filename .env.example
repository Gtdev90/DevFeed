# Copia questo file in .env.local e imposta i valori. Non committare mai .env.local.

# Chiave OpenRouter (https://openrouter.ai/keys). Senza chiave l'app funziona comunque:
# le sintesi diventano un'estrazione automatica dal testo originale, senza traduzione,
# e la traduzione dei titoli del feed non è disponibile.
OPENROUTER_API_KEY=

# Opzionali
# Modello principale (default: google/gemini-2.5-flash)
OPENROUTER_MODEL=google/gemini-2.5-flash
# Modello di riserva se il principale fallisce (default: deepseek/deepseek-chat)
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat
# URL pubblico del sito, inviato a OpenRouter come HTTP-Referer
OPENROUTER_SITE_URL=http://localhost:3000
